# Edge Function secrets — copy to supabase/.env (git-ignored) and run:
#   supabase secrets set --env-file supabase/.env
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are provided
# automatically to Edge Functions by Supabase — do NOT set them here.

# Public site URL (used for links inside emails), no trailing slash
SITE_URL=https://vastrasundari.duckdns.org

# Comma-separated origins allowed to call the functions (CORS)
ALLOWED_ORIGINS=https://vastrasundari.duckdns.org,https://vastrasundari.github.io,http://localhost

# ---- Email (Resend — https://resend.com) ----
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=Vastra Sundari <orders@yourdomain.com>
EMAIL_REPLY_TO=support@yourdomain.com
# Store team inboxes that receive every order notification (comma-separated)
ADMIN_EMAILS=owner@yourdomain.com

# ---- WhatsApp Business Platform (Cloud API) ----
WHATSAPP_ACCESS_TOKEN=EAAxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WHATSAPP_PHONE_NUMBER_ID=123456789012345
WHATSAPP_API_VERSION=v21.0
WHATSAPP_TEMPLATE_NAME=order_alert
WHATSAPP_TEMPLATE_LANG=en
# Business number(s) that receive order alerts, with country code, comma-separated
WHATSAPP_ADMIN_NUMBERS=919876543210
